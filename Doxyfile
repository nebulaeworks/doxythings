# Doxygen configuration for doxythings' own documentation.
# Build with "make docs" (which needs the doxygo filter; see the Makefile); output goes
# to build/docs/html. Only settings that differ from Doxygen's defaults;
# the rest follows the C++ projects' (e.g. KORA's) configuration.

PROJECT_NAME           = doxythings
PROJECT_BRIEF          = "Test, coverage and benchmark results, linked into Doxygen documentation"
OUTPUT_DIRECTORY       = build/docs

# Go, through the doxygo filter (github.com/nebulaeworks/doxygo), which
# rewrites each file into C++-shaped declarations on the same lines. Set
# DOXYGO to its path; "make docs" does.
INPUT                  = README.md cmd internal
RECURSIVE              = YES
FILE_PATTERNS          = *.go *.md
EXCLUDE_PATTERNS       = *_test.go */testdata/*
EXTENSION_MAPPING      = go=C++
FILTER_PATTERNS        = *.go=$(DOXYGO)
USE_MDFILE_AS_MAINPAGE = README.md
TOC_INCLUDE_HEADINGS   = 5

# Go doc comments: the first sentence is the brief description.
JAVADOC_AUTOBRIEF      = YES
ALWAYS_DETAILED_SEC    = YES

# Every entity is documented, unexported ones included, as are every
# parameter and result, and anything missing fails the build.
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES

# Sources, shown as Go, with each function's body under its documentation.
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES

# Doxygen can't follow calls in Go code, so doxygo resolves them with the
# Go type checker and adds the "References" and "Referenced by" lists and
# the call and caller graphs to the documentation itself. Doxygen's own
# would be wrong, so they are off.
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
HTML_DYNAMIC_SECTIONS  = YES
EXT_LINKS_IN_WINDOW    = YES
GENERATE_LATEX         = NO
GENERATE_TAGFILE       = build/docs/doxytags

HAVE_DOT               = YES
HIDE_UNDOC_RELATIONS   = NO
UML_LOOK               = YES
DOT_UML_DETAILS        = YES
TEMPLATE_RELATIONS     = YES
